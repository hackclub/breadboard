# Breadboard app environment
# Copy to .env.local for local development. Never commit real secrets.

# App URL used by auth callbacks and server-side redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string used by the app and Drizzle.
DATABASE_URL=postgresql://user:password@localhost:5432/breadboard
# Set to false for local Postgres without SSL.
DATABASE_SSL=false

# Better Auth secret. Generate with: bunx --bun better-auth secret
BETTER_AUTH_SECRET=

# Hack Club OAuth provider credentials.
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=

# Tookle Slack bot. Bot token needs chat:write, im:write, and reactions:write.
SLACK_BOT_TOKEN=
# Channel ID where Tookle posts new design/demo review notifications.
SLACK_REVIEW_CHANNEL_ID=

# Editor backend. The Next app rewrites editor API routes to this FastAPI service.
EDITOR_BACKEND_URL=http://127.0.0.1:8001
NEXT_PUBLIC_EDITOR_BACKEND_URL=/api

# Optional: required only when building the full ESP32 emulation Docker image
# without local prebuilt QEMU libs in editor-backend/prebuilt/qemu.
VELXIO_LICENSE_KEY=
QEMU_RELEASE_URL=

# S3-compatible storage for project screenshots.
# Silo uses path-style public URLs: https://onsilo.dev/testing-breadboard/file.png
S3_ENDPOINT=https://onsilo.dev
S3_REGION=auto
S3_BUCKET=testing-breadboard
S3_PUBLIC_URL=https://onsilo.dev/testing-breadboard
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Canonical, version-pinned host for the standalone share player (Layer A),
# served via jsDelivr from a GitHub repo tag (CORS-enabled). No trailing slash.
# See share-player/ for how it's built (build.ts) and published (publish-canonical.ts).
SHARE_PLAYER_BASE_URL=https://cdn.jsdelivr.net/gh/hackclub/breadboard-play@v1

# Where each project's static play PAGE (Layer B) is hosted:
#   central (default) — a bot token writes p/<projectId>/ into one shared repo;
#                       no per-student GitHub permission needed. Requires the two
#                       SHARE_PAGES_* vars below.
#   student           — the student's own token writes play/ into their own repo
#                       and enables Pages there (needs the broader `repo` OAuth
#                       scope). No SHARE_PAGES_* needed.
SHARE_HOST_MODE=central
# Central-mode target: "owner/repo" of the shared pages repo, and a token with
# Contents:write + Pages/Administration:write on it (classic `repo`, or a
# fine-grained PAT). Enable GitHub Pages on this repo once (first publish tries
# to enable it automatically). Only used when SHARE_HOST_MODE=central.
SHARE_PAGES_REPO=hackclub/breadboard-plays
SHARE_PAGES_TOKEN=

GROWTHBOOK_CLIENT_KEY=sdk-uSMqqagsih61jWE
GROWTHBOOK_API_HOST=https://cdn.growthbook.io

# Lapse (off-platform build timelapses). Two ways to enable, either works:
# 1) OAuth app: self-serve on Lapse (developer settings / POST /developer/createApp).
#    Register redirect <origin>/api/lapse/auth/callback, scopes "user:read timelapse:read".
LAPSE_CLIENT_ID=
LAPSE_CLIENT_SECRET=
# 2) Program key from the Lapse team: reads users' published timelapses by their
#    Hack Club email with no connect step.
LAPSE_PROGRAM_KEY=
# LAPSE_BASE_URL=https://api.lapse.hackclub.com
# Without any of these, users can still attach YouTube videos to journal entries.

# Loops email audience. Per Hack Club's Loops rules we never touch Loops
# directly; we write rows into the Breadboard program's Airtable table and Hack
# Club's internal tool syncs it to Loops. The app upserts every user and
# waitlist email keyed on the Email column, setting timestamp milestone fields
# (Loops - breadboardCreatedProjectAt / ...SubmittedProjectAt) that Loops
# segments on. Leave blank to disable the sync entirely (it becomes a no-op).
# Personal access token needs data.records:read + data.records:write on the base.
AIRTABLE_API_KEY=
# Base id, looks like app.....
AIRTABLE_BASE_ID=
# Table name or table id (tbl...) for the program's Loops table. The column
# names the app writes to are set in src/lib/loops/airtable.ts; the milestone
# field slugs must mirror Hack Club's unified ship database.
AIRTABLE_TABLE_ID=
# Shared secret guarding POST/GET /api/loops/sync, the full-audience
# reconciliation (one-time backfill + scheduled self-healing sweep). Leave blank
# to disable the endpoint entirely. Generate with: openssl rand -hex 32
LOOPS_SYNC_SECRET=

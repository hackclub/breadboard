editor-backend/prebuilt/qemu/*.so filter=lfs diff=lfs merge=lfs -text
editor-backend/prebuilt/qemu/*.bin filter=lfs diff=lfs merge=lfs -text

# Shell scripts run inside Linux containers; a CRLF checkout on Windows
# breaks their shebang ("exec /entrypoint.sh: no such file or directory").
*.sh text eol=lf
